rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone signed in can check admin status (used to gate the vets
    // directory). Admins are added manually in the console, not by clients.
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anyone signed in can browse lands. Only the owner can create, edit,
    // or delete their own listing. A special case lets ANY signed-in user
    // update just the `bookedRanges` field, because both the owner
    // (accepting a request) and the requester (cancelling a confirmed
    // booking) need to touch that field.
    match /lands/{landId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedRanges']));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // A booking is visible to its owner and its requester only. Either side
    // can create/update within their own role (requester creates the
    // request; owner or requester can update its status).
    match /bookings/{bookingId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.requesterId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || resource.data.requesterId == request.auth.uid);
    }

    // Anyone signed in can browse disease alerts. Only the reporter can
    // withdraw their own report.
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
    }

    // Vets directory is admin-curated only — no self-registration.
    match /vets/{vetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Notifications are only readable/markable-read by their recipient.
    // Creation isn't restricted to the recipient, since the OTHER party in
    // a booking action (e.g. the owner accepting) is the one writing the
    // notification doc for you.
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
                           && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Personal records — only the owner can read/write their own entries.
    match /livestock/{entryId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
    match /landHoldings/{entryId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Admin-posted content — anyone signed in can read, only admins can write.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Chat messages on a confirmed booking — ownerId/requesterId are
    // duplicated onto every message doc (see messagesApi.js) so this rule
    // can check access without a cross-document read.
    match /messages/{messageId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.requesterId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid
                    && (request.resource.data.ownerId == request.auth.uid
                        || request.resource.data.requesterId == request.auth.uid);
    }

    // Publication-contextual one-to-one messaging. An interaction is a
    // conversation between a requester and a publication owner about one
    // publication. Only the two participants may read it; identity/ownership
    // fields are immutable, and each participant may only clear their OWN
    // unread count and only raise the OTHER party's — so nobody can tamper
    // with the other side's unread badge.
    match /interactions/{interactionId} {
      // `resource == null` allows a get() on a not-yet-created interaction,
      // which getOrCreatePublicationInteraction() must do inside its
      // transaction before deciding to create. It leaks nothing (the doc has
      // no data) and does not affect list queries, which are already
      // constrained to the caller by their where() filters.
      allow read: if request.auth != null
                  && (resource == null
                      || resource.data.requesterId == request.auth.uid
                      || resource.data.recipientId == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.interactionType == 'publication_contact'
                    && request.resource.data.contextType == 'publication'
                    && request.resource.data.publicationOwnerId == request.resource.data.recipientId
                    && request.resource.data.requesterUnreadCount == 0
                    && request.resource.data.recipientUnreadCount == 0;

      allow update: if request.auth != null
                    && (resource.data.requesterId == request.auth.uid
                        || resource.data.recipientId == request.auth.uid)
                    // identity / ownership fields are immutable
                    && request.resource.data.requesterId == resource.data.requesterId
                    && request.resource.data.recipientId == resource.data.recipientId
                    && request.resource.data.publicationOwnerId == resource.data.publicationOwnerId
                    && request.resource.data.contextId == resource.data.contextId
                    && request.resource.data.contextType == resource.data.contextType
                    && request.resource.data.interactionType == resource.data.interactionType
                    && request.resource.data.createdAt == resource.data.createdAt
                    // a participant may only lower/keep their own unread count
                    // and only raise/keep the other participant's.
                    && (
                      (request.auth.uid == resource.data.requesterId
                        && request.resource.data.requesterUnreadCount <= resource.data.requesterUnreadCount
                        && request.resource.data.recipientUnreadCount >= resource.data.recipientUnreadCount)
                      ||
                      (request.auth.uid == resource.data.recipientId
                        && request.resource.data.recipientUnreadCount <= resource.data.recipientUnreadCount
                        && request.resource.data.requesterUnreadCount >= resource.data.requesterUnreadCount)
                    );

      // no delete of interactions from clients

      // Messages live under their interaction. Access is derived from the
      // parent interaction's participants. The sender is always the caller;
      // the receiver may only stamp read receipts (not rewrite content).
      match /messages/{messageId} {
        function interactionExists() {
          return exists(/databases/$(database)/documents/interactions/$(interactionId));
        }
        function interactionData() {
          return get(/databases/$(database)/documents/interactions/$(interactionId)).data;
        }
        allow read: if request.auth != null
                    && interactionExists()
                    && (interactionData().requesterId == request.auth.uid
                        || interactionData().recipientId == request.auth.uid);
        allow create: if request.auth != null
                      && interactionExists()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.receiverId != request.auth.uid
                      && (interactionData().requesterId == request.auth.uid
                          || interactionData().recipientId == request.auth.uid);
        allow update: if request.auth != null
                      && request.auth.uid == resource.data.receiverId
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.receiverId == resource.data.receiverId
                      && request.resource.data.text == resource.data.text
                      && request.resource.data.type == resource.data.type;
        // no delete of messages from clients
      }
    }

    // =====================================================================
    // v62 additions (everything above this line is unchanged from v61).
    // Crop Residue, Night Stay and Herds, alert settings, crop safety cards.
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    // Shape check for a field post (create and update).
    function validFieldPost(d) {
      return d.keys().hasOnly([
          'kind', 'ownerId', 'ownerName', 'ownerPhone', 'status', 'hidden',
          'lat', 'lng', 'geohash', 'state', 'district', 'mandal', 'village',
          'photos', 'voiceNote', 'description', 'priceType', 'amount', 'negotiable',
          'availableFrom', 'availableUntil',
          'crop', 'cropOther', 'acres', 'untilFinished', 'allowNightStay', 'waterNearby',
          'notSprayed', 'lastSprayDate',
          'nights', 'animalPreferred', 'extras', 'linkedResiduePostId',
          'animalType', 'animalCount', 'headingTo', 'lookingFor', 'locationUpdatedAt',
          'createdAt', 'updatedAt'])
        && d.kind in ['residue', 'nightStayNeed', 'herdAvailable']
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.geohash is string && d.geohash.size() <= 12
        && d.village is string && d.village.size() > 0 && d.village.size() <= 100
        && d.photos is list && d.photos.size() <= 5
        && (d.voiceNote == null || (d.voiceNote is map && d.voiceNote.durationSec is number && d.voiceNote.durationSec <= 120))
        && (!('description' in d) || (d.description is string && d.description.size() <= 1000))
        && (d.priceType == null || d.priceType in ['perDay', 'perWeek', 'perNight', 'perAcre', 'perSeason', 'fullCompletion', 'lumpSum', 'freeForManure'])
        && (d.amount == null || (d.amount is number && d.amount > 0 && d.amount <= 10000000))
        && d.status in ['available', 'partly', 'full', 'closed']
        && d.hidden is bool;
    }

    // Anyone signed in can browse posts that are not hidden by an admin; the
    // owner can always see their own. The app queries with hidden == false.
    // Owners create, edit, set status and delete their own posts, but can
    // never un-hide a post an admin hid (Central Admin uses the Admin SDK).
    match /fieldPosts/{postId} {
      allow read: if signedIn()
                  && (resource.data.hidden == false || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.hidden == false
                    && request.resource.data.status == 'available'
                    && validFieldPost(request.resource.data);
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.hidden == resource.data.hidden
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status in ['available', 'partly', 'full']
                    && validFieldPost(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Push tokens: one document per phone, only for that user.
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['fcmToken', 'lang', 'platform', 'updatedAt'])
                            && request.resource.data.fcmToken is string
                            && request.resource.data.fcmToken.size() < 4096
                            && request.resource.data.lang in ['en', 'te', 'hi'];
    }

    // Alert preferences: only the user.
    match /notificationSettings/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['radiusKm', 'quietHours', 'types', 'updatedAt'])
                            && request.resource.data.radiusKm in [5, 10, 25]
                            && request.resource.data.quietHours is bool
                            && request.resource.data.types is map;
    }

    // Crop safety cards and settings: everyone signed in reads; only Central
    // Admin (server, Admin SDK) writes.
    match /cropGuides/{cropId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /cropGuideSettings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Used only by Cloud Functions to avoid repeat alerts. No app access.
    match /alertLog/{entryId} {
      allow read, write: if false;
    }
  }
}
