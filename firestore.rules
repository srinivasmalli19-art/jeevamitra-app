rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone signed in can check admin status (used to gate the vets
    // directory). Admins are added manually in the console, not by clients.
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anyone signed in can browse lands. Only the owner can create, edit,
    // or delete their own listing. A special case lets ANY signed-in user
    // update just the `bookedRanges` field, because both the owner
    // (accepting a request) and the requester (cancelling a confirmed
    // booking) need to touch that field.
    match /lands/{landId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedRanges']));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // A booking is visible to its owner and its requester only. Either side
    // can create/update within their own role (requester creates the
    // request; owner or requester can update its status).
    match /bookings/{bookingId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.requesterId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerId == request.auth.uid
                        || resource.data.requesterId == request.auth.uid);
    }

    // Anyone signed in can browse disease alerts. Only the reporter can
    // withdraw their own report.
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;
    }

    // Vets directory is admin-curated only — no self-registration.
    match /vets/{vetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Notifications are only readable/markable-read by their recipient.
    // Creation isn't restricted to the recipient, since the OTHER party in
    // a booking action (e.g. the owner accepting) is the one writing the
    // notification doc for you.
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
                           && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Personal records — only the owner can read/write their own entries.
    match /livestock/{entryId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
    match /landHoldings/{entryId} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Admin-posted content — anyone signed in can read, only admins can write.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Chat messages on a confirmed booking — ownerId/requesterId are
    // duplicated onto every message doc (see messagesApi.js) so this rule
    // can check access without a cross-document read.
    match /messages/{messageId} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.requesterId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid
                    && (request.resource.data.ownerId == request.auth.uid
                        || request.resource.data.requesterId == request.auth.uid);
    }

    // Publication-contextual one-to-one messaging. An interaction is a
    // conversation between a requester and a publication owner about one
    // publication. Only the two participants may read it; identity/ownership
    // fields are immutable, and each participant may only clear their OWN
    // unread count and only raise the OTHER party's — so nobody can tamper
    // with the other side's unread badge.
    match /interactions/{interactionId} {
      allow read: if request.auth != null
                  && (resource.data.requesterId == request.auth.uid
                      || resource.data.recipientId == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.interactionType == 'publication_contact'
                    && request.resource.data.contextType == 'publication'
                    && request.resource.data.publicationOwnerId == request.resource.data.recipientId
                    && request.resource.data.requesterUnreadCount == 0
                    && request.resource.data.recipientUnreadCount == 0;

      allow update: if request.auth != null
                    && (resource.data.requesterId == request.auth.uid
                        || resource.data.recipientId == request.auth.uid)
                    // identity / ownership fields are immutable
                    && request.resource.data.requesterId == resource.data.requesterId
                    && request.resource.data.recipientId == resource.data.recipientId
                    && request.resource.data.publicationOwnerId == resource.data.publicationOwnerId
                    && request.resource.data.contextId == resource.data.contextId
                    && request.resource.data.contextType == resource.data.contextType
                    && request.resource.data.interactionType == resource.data.interactionType
                    && request.resource.data.createdAt == resource.data.createdAt
                    // a participant may only lower/keep their own unread count
                    // and only raise/keep the other participant's.
                    && (
                      (request.auth.uid == resource.data.requesterId
                        && request.resource.data.requesterUnreadCount <= resource.data.requesterUnreadCount
                        && request.resource.data.recipientUnreadCount >= resource.data.recipientUnreadCount)
                      ||
                      (request.auth.uid == resource.data.recipientId
                        && request.resource.data.recipientUnreadCount <= resource.data.recipientUnreadCount
                        && request.resource.data.requesterUnreadCount >= resource.data.requesterUnreadCount)
                    );

      // no delete of interactions from clients

      // Messages live under their interaction. Access is derived from the
      // parent interaction's participants. The sender is always the caller;
      // the receiver may only stamp read receipts (not rewrite content).
      match /messages/{messageId} {
        function interactionData() {
          return get(/databases/$(database)/documents/interactions/$(interactionId)).data;
        }
        allow read: if request.auth != null
                    && (interactionData().requesterId == request.auth.uid
                        || interactionData().recipientId == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.receiverId != request.auth.uid
                      && (interactionData().requesterId == request.auth.uid
                          || interactionData().recipientId == request.auth.uid);
        allow update: if request.auth != null
                      && request.auth.uid == resource.data.receiverId
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.receiverId == resource.data.receiverId
                      && request.resource.data.text == resource.data.text
                      && request.resource.data.type == resource.data.type;
        // no delete of messages from clients
      }
    }
  }
}
