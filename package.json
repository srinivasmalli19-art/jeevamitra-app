{
  "name": "jeevamitra-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "VITE_USE_EMULATOR=1 vite",
    "emulators": "npx -y firebase-tools emulators:start --only auth,firestore --project jeeva-575fd",
    "build": "vite build",
    "deploy:firestore-rules": "npx -y firebase-tools deploy --only firestore:rules --project jeeva-575fd",
    "lint": "oxlint",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@react-google-maps/api": "^2.20.8",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
